{
  "name": "io.github.michael32034.colnet",
  "displayName": "Colnet",
  "version": "1.0.0",
  "description": "College Web Diary Project",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "add:browser: "cordova platform add browser",
    "build": "cordova build browser",
    "build_dev": "DEBUG=true cordova build browser",
    "bootstrap": "cp node_modules/bootstrap/dist/css/bootstrap.min.css www/css/bootstrap.min.css && cp node_modules/bootstrap/dist/js/bootstrap.bundle.min.js www/js/bootstrap.bundle.min.js",
    "compile": "cordova build android",
