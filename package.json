    "esbuild": "^0.27.2"
  },
  "cordova": {
    "platforms": [
      "android",
      "browser"
    ]
  },
  "dependencies": {
    "pathcat": "^1.5.1",
    "ts-safe-enum": "^2.0.0"
  }
